# 统一文本行尾为 LF，消除 Windows 下 LF/CRLF 混用警告
* text=auto eol=lf

# Windows 脚本保留 CRLF（原生约定）
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件：不参与行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.pdf binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.eot binary
